<robot name="toy_g1">
<link name="pelvis"/>
<link name="waist_yaw_link"/>
<joint name="waist_yaw_joint" type="revolute"><parent link="pelvis"/><child link="waist_yaw_link"/><origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-0.5" upper="0.5" effort="50" velocity="3"/></joint>
<link name="waist_roll_link"/>
<joint name="waist_roll_joint" type="revolute"><parent link="waist_yaw_link"/><child link="waist_roll_link"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="-0.5" upper="0.5" effort="50" velocity="3"/></joint>
<link name="torso_link"/>
<joint name="waist_pitch_joint" type="revolute"><parent link="waist_roll_link"/><child link="torso_link"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-0.5" upper="0.5" effort="50" velocity="3"/></joint>
<link name="left_shoulder_pitch_link"/>
<joint name="left_shoulder_pitch_joint" type="revolute"><parent link="torso_link"/><child link="left_shoulder_pitch_link"/><origin xyz="0 0.15 0.25" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
<link name="left_shoulder_roll_link"/>
<joint name="left_shoulder_roll_joint" type="revolute"><parent link="left_shoulder_pitch_link"/><child link="left_shoulder_roll_link"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
<link name="left_shoulder_yaw_link"/>
<joint name="left_shoulder_yaw_joint" type="revolute"><parent link="left_shoulder_roll_link"/><child link="left_shoulder_yaw_link"/><origin xyz="0 0 -0.05" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
<link name="left_elbow_link"/>
<joint name="left_elbow_joint" type="revolute"><parent link="left_shoulder_yaw_link"/><child link="left_elbow_link"/><origin xyz="0 0 -0.15" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.0" upper="2.0" effort="20" velocity="3"/></joint>
<link name="left_wrist_roll_link"/>
<joint name="left_wrist_roll_joint" type="revolute"><parent link="left_elbow_link"/><child link="left_wrist_roll_link"/><origin xyz="0 0 -0.08" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
<link name="left_wrist_pitch_link"/>
<joint name="left_wrist_pitch_joint" type="revolute"><parent link="left_wrist_roll_link"/><child link="left_wrist_pitch_link"/><origin xyz="0 0 -0.04" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
<link name="left_wrist_yaw_link"/>
<joint name="left_wrist_yaw_joint" type="revolute"><parent link="left_wrist_pitch_link"/><child link="left_wrist_yaw_link"/><origin xyz="0 0 -0.03" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
<link name="right_shoulder_pitch_link"/>
<joint name="right_shoulder_pitch_joint" type="revolute"><parent link="torso_link"/><child link="right_shoulder_pitch_link"/><origin xyz="0 -0.15 0.25" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
<link name="right_shoulder_roll_link"/>
<joint name="right_shoulder_roll_joint" type="revolute"><parent link="right_shoulder_pitch_link"/><child link="right_shoulder_roll_link"/><origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
<link name="right_shoulder_yaw_link"/>
<joint name="right_shoulder_yaw_joint" type="revolute"><parent link="right_shoulder_roll_link"/><child link="right_shoulder_yaw_link"/><origin xyz="0 0 -0.05" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
<link name="right_elbow_link"/>
<joint name="right_elbow_joint" type="revolute"><parent link="right_shoulder_yaw_link"/><child link="right_elbow_link"/><origin xyz="0 0 -0.15" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.0" upper="2.0" effort="20" velocity="3"/></joint>
<link name="right_wrist_roll_link"/>
<joint name="right_wrist_roll_joint" type="revolute"><parent link="right_elbow_link"/><child link="right_wrist_roll_link"/><origin xyz="0 0 -0.08" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
<link name="right_wrist_pitch_link"/>
<joint name="right_wrist_pitch_joint" type="revolute"><parent link="right_wrist_roll_link"/><child link="right_wrist_pitch_link"/><origin xyz="0 0 -0.04" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
<link name="right_wrist_yaw_link"/>
<joint name="right_wrist_yaw_joint" type="revolute"><parent link="right_wrist_pitch_link"/><child link="right_wrist_yaw_link"/><origin xyz="0 0 -0.03" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-2.5" upper="2.5" effort="20" velocity="3"/></joint>
</robot>